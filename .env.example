# Пример значений: настоящие секреты задаются только в Render → Environment.
PORT=10000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:example@localhost:5432/nashklining
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-random-password-here

# Необязательно: уведомления менеджера о заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: AI-консультант сайта и разрешённые Telegram Business диалоги.
# OpenAI API оплачивается отдельно от ChatGPT, по использованию.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Для внешних PostgreSQL провайдеров с обязательным TLS.
DATABASE_SSL=false
# Необязательно. В Render адрес обычно доступен в RENDER_EXTERNAL_URL.
# SITE_URL=https://your-service.onrender.com
